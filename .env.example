# ---- Core ----
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=
# Leave DATABASE_URL empty for local SQLite. Production example:
# DATABASE_URL=postgresql://maagi:password@localhost:5432/maagi
SITE_URL=http://127.0.0.1:5000

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Dev only: lets you test the payment flow without Razorpay keys. Never enable in production.
ALLOW_PAYMENT_SIMULATION=true

# ---- Mail (SMTP) ----
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=

# ---- Company (shown on site + invoices) ----
COMPANY_NAME=Maagi Pickle
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_GSTIN=

# ---- Seed passwords (development only) ----
DEMO_PASSWORD=Maagi@12345
